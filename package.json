{
  "name": "thing-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@clerk/clerk-react": "^5.20.0",
    "@hono/clerk-auth": "^2.0.0",
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.8.1",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "vite": "^5.4.10"
  }
}
